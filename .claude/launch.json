{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aurafin-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "aurafin-api",
      "runtimeExecutable": "api/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "api", "--port", "8000"],
      "port": 8000
    }
  ]
}
