# Anthropic credentials. With AURAFIN_COACH_MODE=auto, the API uses Claude when a key is set
# and falls back to the built-in offline plan generator when it is not.
ANTHROPIC_API_KEY=

# auto | live | mock
AURAFIN_COACH_MODE=auto
# claude-3-5-sonnet is retired; claude-sonnet-5-5 is the current Sonnet.
AURAFIN_MODEL=claude-sonnet-5-5
AURAFIN_EFFORT=medium
AURAFIN_MAX_TOKENS=16000

# Comma-separated list of browser origins allowed to call the API
AURAFIN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
