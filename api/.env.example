# Anthropic credentials (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Claude model used by the coach. claude-3-5-sonnet is retired; claude-sonnet-5-5 is the current Sonnet.
AURAFIN_MODEL=claude-sonnet-5-5
AURAFIN_EFFORT=low
AURAFIN_MAX_TOKENS=4096

# Comma-separated list of browser origins allowed to call the API
AURAFIN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
