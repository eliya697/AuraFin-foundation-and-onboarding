# Google Gemini API key (https://aistudio.google.com/apikey). With AURAFIN_COACH_MODE=auto, the API
# uses Gemini when a key is set and falls back to the built-in offline plan generator when it is not.
GEMINI_API_KEY=

# auto | live | mock
AURAFIN_COACH_MODE=auto
# gemini-1.5-flash and gemini-2.0-flash are shut down. Any current Gemini model ID works here.
AURAFIN_MODEL=gemini-3.8-flash
AURAFIN_MAX_TOKENS=16000

# Comma-separated list of browser origins allowed to call the API
AURAFIN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://eliya697.github.io
