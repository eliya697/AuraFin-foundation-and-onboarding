# Supabase (leave empty to run in local-only mode backed by localStorage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI coach: "live" streams from the FastAPI service, "mock" uses the built-in offline generator
VITE_COACH_MODE=mock
# Base URL of the FastAPI service. Empty = same origin (Vite dev server proxies /api to :8000)
VITE_COACH_API_URL=
