# Base URL of the FastAPI service. Empty = same origin (the Vite dev server proxies /api to :8000).
VITE_API_URL=https://aurafin-foundation-and-onboarding.onrender.com

# Supabase project (Project Settings → API → Project URL and the anon / publishable key).
# These are baked into the bundle when `vite build` runs (`npm run deploy` builds first), so they must be
# present on the machine or CI job that builds — GitHub Pages itself cannot inject them. Put them in:
#   - web/.env.production         used by `npm run build` / `npm run deploy` (committed; the anon key is public)
#   - web/.env.production.local   same, but git-ignored, if you prefer not to commit them
#   - environment variables       e.g. GitHub Actions secrets passed as `env:` to the build step
# A production build fails if both are missing. `npm run dev` without them uses a browser-only dev login.
# Format: VITE_SUPABASE_URL=https://<project-ref>.supabase.co. Never use the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google sign-in needs no variable here: enable the Google provider in Supabase (see README, setup step 6).
