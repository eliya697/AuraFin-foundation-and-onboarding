# Base URL of the FastAPI service. Empty = same origin (the Vite dev server proxies /api to :8000).
VITE_API_URL=https://aurafin-foundation-and-onboarding.onrender.com

# Supabase project (Project Settings → API). Required for production builds: without them the
# deployed app shows a "setup required" screen. `npm run dev` falls back to a browser-only dev login.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
